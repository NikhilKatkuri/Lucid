# API
VITE_API_URL=http://localhost:5000/api
VITE_USE_MOCK=true                # true = typed mock layer, no server needed

# App
VITE_APP_NAME=Inventory
VITE_PAGE_SIZE_DEFAULT=25

# NOTE: never put AWS access keys, secret keys or bucket credentials in any
# VITE_* variable — everything here is bundled into public JavaScript.
