<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.31" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Enables `dotnet user-secrets`, which stores Mongo/JWT credentials in a
         per-user location outside the repository. Only this GUID is committed. -->
    <UserSecretsId>lucid-api-2f9c1d84</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lucid.Domain\Lucid.Domain.csproj" />
    <ProjectReference Include="..\Lucid.Application\Lucid.Application.csproj" />
    <ProjectReference Include="..\Lucid.Infrastructure\Lucid.Infrastructure.csproj" />
  </ItemGroup>

</Project>
