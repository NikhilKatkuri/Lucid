{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "lucid"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "lucid:"
  },
  "S3": {
    "Bucket": "lucid-files",
    "Region": "us-east-1",
    "Endpoint": "http://localhost:4566",
    "AccessKey": "",
    "SecretKey": ""
  },
  "Jwt": {
    "Issuer": "lucid",
    "Audience": "lucid",
    "Key": "",
    "ExpiryMinutes": 60
  },
  "RateLimit": {
    "DefaultLimit": 100,
    "DefaultWindowSeconds": 60,
    "AuthLimit": 5,
    "AuthWindowSeconds": 60,
    "UploadLimit": 10,
    "UploadWindowSeconds": 60
  },
  "Tenant": {
    "BaseDomain": "lucid.app",
    "ReservedSubdomains": [ "www", "api", "admin", "app", "mail", "ftp", "localhost" ]
  }
}
