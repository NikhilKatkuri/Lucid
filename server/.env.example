# Copy to .env and replace the signing key with a random value (32+ characters).
JWT_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Optional MongoDB Atlas connection string; defaults to the local Compose replica set.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
